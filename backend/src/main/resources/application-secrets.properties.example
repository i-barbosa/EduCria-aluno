# Copie este arquivo para application-secrets.properties (mesma pasta) e preencha com seus
# valores reais. application-secrets.properties fica fora do Git (ver .gitignore) - nunca commite
# a chave de verdade.
#
# Sem esse arquivo, o backend funciona normal - so nao envia e-mail de credenciais
# (EmailService loga um aviso e a coordenacao usa a senha mostrada na tela do /admin).

educria.email.brevo-api-key=
educria.email.remetente=
